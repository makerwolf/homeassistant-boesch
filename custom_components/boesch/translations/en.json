      "inputs": {
        "title": "Sensor inputs",
        "description": "Wiring is installation-specific. Entering a name enables and labels the input; leave blank to hide it.",
        "data": {
          "boesch_hb_ai1": "AI1 (CN6)",
          "boesch_hb_ai2": "AI2 (CN6)",
          "boesch_hb_ai3": "AI3 (CN47)",
          "boesch_hb_ai4": "AI4 (CN47)",
          "boesch_hb_t1": "T1 (CN10)",
          "boesch_hb_ai6": "AI6 (CN13)",
          "boesch_hb_ai7": "AI7 (CN15)",
          "boesch_hb_ai8": "AI8 (CN13)",
          "boesch_hb_tw_ibh": "Tw (IBH)"
        }
      },
      "web": {
        "title": "Web interface",
        "description": "Settings not available via Modbus (heating mode, fixed setpoints, heating curve, mixer, presence), via the heat pump's web interface. Password as used for the browser login; leave empty to disable these features.",
        "data": {
          "web_password": "Web password",
          "web_power": "High-resolution power values from the web interface"
        },
        "data_description": {
          "web_power": "Replaces the 8 power sensors (Modbus, truncated to 0.1 kW) with the web values at 0.01 kW. Entity IDs stay the same, the energy counters become more accurate. If the web interface fails, the Modbus values are used."
        }
      }
    },
    "error": {
      "invalid_auth": "Web password rejected.",
      "web_cannot_connect": "Web interface unreachable or Hydrobox not found."
    }
  },
