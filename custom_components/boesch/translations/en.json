{
  "config": {
    "flow_title": "Bösch ({host})",
    "step": {
      "user": {
        "title": "Connect Bösch",
        "description": "Modbus TCP connection to WANDA and Hydrobox.",
        "data": {
          "host": "IP address",
          "port": "Port",
          "wanda_address": "WANDA Modbus address",
          "hydrobox_address": "Hydrobox Modbus address",
          "web_password": "Web password (optional)"
        },
        "data_description": {
          "host": "IP address of the heat pump on the local network, e.g. from your router's device list.",
          "web_password": "Only needed for heating mode, fixed setpoints and heating curve via the web interface. Can be changed later in the options."
        }
      },
      "reconfigure": {
        "title": "Bösch – change connection",
        "description": "New IP address or Modbus settings of the heat pump. Modbus TCP has no authentication, so no password is needed. The web password is changed in the options.",
        "data": {
          "host": "IP address",
          "port": "Port",
          "wanda_address": "WANDA Modbus address",
          "hydrobox_address": "Hydrobox Modbus address"
        }
      },
      "reauth_confirm": {
        "title": "Bösch – web password",
        "description": "The web interface rejected the stored password. Enter the current web password. To turn the web features off instead, clear the password in the options.",
        "data": {
          "web_password": "Web password"
        }
      }
    },
    "error": {
      "cannot_connect": "Connection failed. Check IP, port and Modbus address.",
      "unknown": "Unexpected error.",
      "invalid_auth": "Web password rejected.",
      "web_cannot_connect": "Web interface unreachable or Hydrobox not found."
    },
    "abort": {
      "already_configured": "This host is already configured.",
      "reconfigure_successful": "Connection updated, reloading the integration.",
      "reauth_successful": "Web password updated, reloading the integration."
    }
  },
